{
  "id": "notes",
  "name": "笔记",
  "version": "1.0.0",
  "permissions": ["plugin.data"],
  "serverActions": [
    { "name": "list-notes",    "permissions": ["plugin.data"] },
    { "name": "save-note",     "permissions": ["plugin.data"] },
