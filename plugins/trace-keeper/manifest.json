{
  "id": "trace-keeper",
  "name": "Trace Keeper",
  "version": "0.1.0",
  "hooks": [
    "resolveAfterAssemblePromptsAddition",
    "resolveTurnPluginEntriesFromAssistant",
    "formatPluginContextBlocks",
    "runTool",
    "runNode"
  ],
  "assembleInjection": {
    "slots": {
      "default": 500
    },
    "slotSettingsKeys": {
      "default": "injectionOrderDefault"
    }
  },
  "turnPlugins": {
    "mergeMode": "receive-scoped",
    "receiveIdKey": "receiveId"
  },
  "serverActions": [
    {
      "name": "regenerate-separate",
      "permissions": ["plugin.complete", "conversation.read"]
    },
    {
      "name": "patch-state",
      "permissions": ["turn.plugins.write", "conversation.read"]
    }
  ],
  "tools": [
    {
      "name": "trace_read",
      "phase": "read",
      "maxCallsPerTurn": 1,
      "description": "Read recent Trace Keeper snapshots (last N turns) and current live state. Call at most once before writing the user-visible reply.",
      "uiTitleKey": "agentToolReadTitle",
      "uiDescriptionKey": "agentToolReadDesc",
      "permissions": ["conversation.read", "plugin.data"],
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "turns": {
            "type": "integer",
            "minimum": 1,
            "maximum": 40,
            "description": "Optional override; default from plugin setting toolReadTurnCount"
          }
        }
      }
    },
    {
      "name": "trace_init",
      "phase": "write",
      "maxCallsPerTurn": 1,
      "description": "Write tool: initialize tracker live state from sampleState. Call ONLY when this conversation has no live/turn snapshot for the current epoch. Mutually exclusive with trace_patch for the same purpose—if data already exists, use trace_patch instead. At most once per turn.",
      "uiTitleKey": "agentToolInitTitle",
      "uiDescriptionKey": "agentToolInitDesc",
      "permissions": ["conversation.read", "plugin.data", "turn.plugins.write"],
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      }
    },
    {
      "name": "trace_patch",
      "phase": "write",
      "description": "Write tool: apply RFC6902-subset ops (replace/add/remove) to the scene tracker when data already exists. Mutually exclusive with trace_init—do not call init if a snapshot/live state exists; call init first only when uninitialized. Never replace the whole state object in one shot.",
      "uiTitleKey": "agentToolPatchTitle",
      "uiDescriptionKey": "agentToolPatchDesc",
      "permissions": ["conversation.read", "plugin.data", "turn.plugins.write"],
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ops"],
        "properties": {
          "ops": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["op", "path"],
              "properties": {
                "op": {
                  "type": "string",
                  "enum": ["replace", "add", "remove"]
                },
                "path": {
                  "type": "string",
                  "description": "JSON Pointer, e.g. /scene/location or /inventory/-"
                },
                "value": {}
              }
            }
          }
        }
      }
    }
  ],
  "nodeTypes": [
    {
      "type": "trace-keeper.exists",
      "version": 1,
      "titleKey": "agentNodeExistsTitle",
      "descriptionKey": "agentNodeExistsDesc",
      "permissions": ["conversation.read", "plugin.data"],
      "inputs": [],
      "outputs": [
        { "name": "ok", "valueType": "boolean" },
        { "name": "exists", "valueType": "boolean" },
        { "name": "source", "valueType": "string" },
        { "name": "epoch", "valueType": "number" }
      ]
    }
  ],
  "lifecycle": {
    "onCharacterPrimaryChanged": true
  },
  "memory": {
    "stripBlockTags": ["ex-trace-keeper"]
  },
  "permissions": [
    "conversation.read",
    "turn.read",
    "turn.plugins.write",
    "plugin.complete",
    "plugin.data"
  ],
  "settingsSchema": {
    "version": 1,
    "dialogMaxWidth": 920,
    "fields": [
      {
        "key": "injectionOrderDefault",
        "type": "number",
        "labelKey": "injectionOrderDefaultLabel",
        "descriptionKey": "injectionOrderDefaultDesc",
        "min": 0,
        "max": 9999,
        "default": 500
      },
      {
        "key": "activeBundleId",
        "type": "string",
        "labelKey": "activeBundleIdLabel",
        "descriptionKey": "activeBundleIdDesc",
        "default": "scene-tracker-default",
        "widget": "bundleSelect",
        "bundleSelect": {
          "listFieldKey": "bundleList",
          "builtinValue": "scene-tracker-default",
          "builtinLabelKey": "bundleBuiltinOption"
        }
      },
      {
        "key": "apiConfigId",
        "type": "apiPreset",
        "labelKey": "apiConfigIdLabel",
        "descriptionKey": "apiConfigIdDesc",
        "default": ""
      },
      {
        "key": "separateTurnCount",
        "type": "number",
        "labelKey": "separateTurnCountLabel",
        "descriptionKey": "separateTurnCountDesc",
        "default": "4"
      },
      {
        "key": "toolReadTurnCount",
        "type": "number",
        "labelKey": "toolReadTurnCountLabel",
        "descriptionKey": "toolReadTurnCountDesc",
        "min": 1,
        "max": 40,
        "default": 8
      },
      {
        "key": "validateSampleStateJson",
        "type": "boolean",
        "labelKey": "validateSampleStateJsonLabel",
        "descriptionKey": "validateSampleStateJsonDesc",
        "default": true
      },
      {
        "key": "bundleList",
        "type": "objectList",
        "labelKey": "bundleListLabel",
        "descriptionKey": "bundleListDesc",
        "default": "[]",
        "objectListValidation": "bundleList",
        "validateSampleStateWhen": "validateSampleStateJson",
        "reservedObjectListIds": ["scene-tracker-default"],
        "itemFields": [
          {
            "key": "label",
            "type": "string",
            "labelKey": "bundleItemLabelLabel",
            "descriptionKey": "bundleItemLabelDesc",
            "required": true
          },
          {
            "key": "systemPromptTemplate",
            "type": "text",
            "labelKey": "bundleItemSystemPromptLabel",
            "descriptionKey": "bundleItemSystemPromptDesc",
            "widget": "promptTemplate",
            "defaultKey": "systemPromptTemplateDefault",
            "maxLength": 0
          },
          {
            "key": "separateSystemPromptTemplate",
            "type": "text",
            "labelKey": "bundleItemSeparateSystemPromptLabel",
            "descriptionKey": "bundleItemSeparateSystemPromptDesc",
            "widget": "promptTemplate",
            "defaultKey": "separateSystemPromptTemplateDefault",
            "maxLength": 0
          },
          {
            "key": "sampleStateJson",
            "type": "text",
            "labelKey": "bundleItemSampleStateLabel",
            "descriptionKey": "bundleItemSampleStateDesc",
            "defaultKey": "bundleSampleStateJsonDefault",
            "widget": "jsonSampleState",
            "maxLength": 0
          },
          {
            "key": "template",
            "type": "text",
            "labelKey": "bundleItemTemplateLabel",
            "descriptionKey": "bundleItemTemplateDesc",
            "defaultKey": "bundleTemplateDefault",
            "maxLength": 0
          },
          {
            "key": "stylesheet",
            "type": "text",
            "labelKey": "bundleItemStylesheetLabel",
            "descriptionKey": "bundleItemStylesheetDesc",
            "defaultKey": "bundleStylesheetDefault",
            "maxLength": 0
          }
        ]
      }
    ]
  },
  "conversationSettingsSchema": {
    "version": 1,
    "fields": [
      {
        "key": "apiConfigId",
        "type": "apiPreset",
        "labelKey": "convApiConfigIdLabel",
        "descriptionKey": "convApiConfigIdDesc",
        "default": "",
        "conversationInherit": true,
        "inheritFromGlobalKey": "apiConfigId"
      },
      {
        "key": "bundleId",
        "type": "string",
        "labelKey": "convBundleIdLabel",
        "descriptionKey": "convBundleIdDesc",
        "default": "",
        "widget": "bundleSelect",
        "bundleSelect": {
          "listFieldKey": "bundleList",
          "inheritOption": true,
          "inheritLabelKey": "convBundleInheritOption"
        }
      },
      {
        "key": "separateTurnCount",
        "type": "number",
        "labelKey": "convSeparateTurnCountLabel",
        "descriptionKey": "convSeparateTurnCountDesc",
        "default": ""
      },
      {
        "key": "toolReadTurnCount",
        "type": "number",
        "labelKey": "convToolReadTurnCountLabel",
        "descriptionKey": "convToolReadTurnCountDesc",
        "min": 1,
        "max": 40,
        "default": "",
        "conversationInherit": true,
        "inheritFromGlobalKey": "toolReadTurnCount"
      }
    ]
  },
  "ui": {
    "eagerOnRoutes": ["chat"],
    "slots": [
      {
        "name": "assistant-turn",
        "entry": "./dist/web.mjs"
      }
    ]
  }
}
